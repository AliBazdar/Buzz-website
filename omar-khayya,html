    <!-- ===== JAVASCRIPT (Dark mode + Filters) ===== -->
    <script>
        (function() {
            'use strict';

            // --- Dark Mode Toggle ---
            const toggle = document.getElementById('theme-toggle');
            const html = document.documentElement;

            // load saved preference
            const savedTheme = localStorage.getItem('buzz-theme');
            if (savedTheme === 'dark') {
                html.setAttribute('data-theme', 'dark');
                toggle.innerHTML = '<span aria-hidden="true">☀</span>';
            }

            toggle.addEventListener('click', function() {
                const isDark = html.getAttribute('data-theme') === 'dark';
                if (isDark) {
                    html.removeAttribute('data-theme');
                    localStorage.setItem('buzz-theme', 'light');
                    toggle.innerHTML = '<span aria-hidden="true">☾</span>';
                } else {
                    html.setAttribute('data-theme', 'dark');
                    localStorage.setItem('buzz-theme', 'dark');
                    toggle.innerHTML = '<span aria-hidden="true">☀</span>';
                }
            });

            // --- Filter Functionality ---
            const themeSelect = document.getElementById('filter-theme');
            const authSelect = document.getElementById('filter-authenticity');
            const entries = document.querySelectorAll('.rubaiyat-entry');

            function filterEntries() {
                const theme = themeSelect.value;
                const auth = authSelect.value;

                entries.forEach(entry => {
                    const entryTheme = entry.dataset.theme || '';
                    const entryAuth = entry.dataset.authenticity || '';

                    let show = true;
                    if (theme !== 'all' && entryTheme !== theme) show = false;
                    if (auth !== 'all' && entryAuth !== auth) show = false;

                    entry.style.display = show ? 'block' : 'none';
                });
            }

            themeSelect.addEventListener('change', filterEntries);
            authSelect.addEventListener('change', filterEntries);

        })();
    </script>

</body>
