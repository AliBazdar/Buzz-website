<body class="rubaiyat-archive">

    <!-- ===== HEADER / NAV ===== -->
    <header>
        <nav class="site-nav">
            <a href="index.html" class="logo">Buzz Codex</a>
            <ul>
                <li><a href="index.html">Home</a></li>
